GEMINI_API_KEY=replace_with_gemini_key

# Production runner settings
SPOTIFY_GEMINI_MODEL=gemini-2.5-flash
SPOTIFY_GEMINI_SLEEP_SECONDS=70
SPOTIFY_GEMINI_TIMEOUT=600
SPOTIFY_PIPELINE_TIMEOUT=21600
SPOTIFY_REQUIRE_ZH_TRANSCRIPTS=0

# Zotero local DB mode. The service can quit Zotero before writing so sqlite is not locked.
SPOTIFY_ZOTERO_QUIT_BEFORE_WRITE=1

# Google Drive upload must target the real folder, not Drive root.
# Example with rclone remote named gdrive:
# SPOTIFY_GOOGLE_DRIVE_UPLOAD_CMD=rclone copy "{docx}" "gdrive:1.Spotify情报汇总/" --checksum
# Optional command that exits 0 only when the uploaded file is visible.
# SPOTIFY_GOOGLE_DRIVE_VERIFY_CMD=rclone lsf "gdrive:1.Spotify情报汇总/" --files-only

# Discord bot delivery. The existing Discord Studio path can be used as cwd.
SPOTIFY_DISCORD_CHANNEL_ID=1508163671988109393
SPOTIFY_DISCORD_CWD=/Users/hannah/.discord-studio/Discord_Studio
# SPOTIFY_DISCORD_SEND_CMD=npm run send:discord -- "{channel_id}" "{message}" "{pdf}"
